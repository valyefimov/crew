# Where Crew keeps its database (default: ~/.crew)
CREW_HOME=~/.crew
CREW_PORT=3000

# Model provider: ollama (default) or openai (any OpenAI-compatible API: LM Studio, vLLM, OpenAI…)
CREW_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
CREW_MODEL=qwen2.5:3b
CREW_EMBED_MODEL=nomic-embed-text

# OpenAI-compatible provider
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=lm-studio

# Telegram
# CREW_TELEGRAM_TOKEN=123456:ABC...
