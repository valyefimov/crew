{
  "name": "crew-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Crew — a lightweight local-first workspace for your persistent AI colleagues",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @crew/server --filter @crew/web dev",
    "build": "pnpm --filter @crew/web build && pnpm --filter @vefimov/crew build",
    "start": "node cli/dist/crew.js start",
    "crew": "tsx cli/src/index.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "docs:dev": "pnpm --filter crew-docs dev",
    "docs:build": "pnpm --filter crew-docs build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
