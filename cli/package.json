{
  "name": "@vefimov/crew",
  "version": "1.0.1",
  "description": "A lightweight local-first workspace for your persistent AI colleagues. Memory, files, Telegram — one command.",
  "type": "module",
  "license": "MIT",
  "author": "Valentyn Yefimov <valentine.efimov@gmail.com>",
  "homepage": "https://valyefimov.github.io/crew/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valyefimov/crew.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/valyefimov/crew/issues",
  "keywords": ["ai", "agents", "local-first", "ollama", "llm", "memory", "telegram", "assistant", "self-hosted"],
  "bin": {
    "crew": "dist/crew.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-web.mjs && node scripts/copy-readme.mjs",
