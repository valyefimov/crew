    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "commander": "^15.0.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "open": "^11.0.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@crew/channels": "workspace:*",
    "@crew/core": "workspace:*",
    "@crew/server": "workspace:*",
    "tsup": "^8.5.1"
  }
